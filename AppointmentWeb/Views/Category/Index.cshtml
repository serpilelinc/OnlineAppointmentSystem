@model List<AppointmentWeb.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Kategori Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="mb-1">Kategori Yönetimi</h2>

        <p class="text-muted mb-0">
            Platformda sunulan hizmetleri kategoriler altında yönetin.
        </p>
    </div>

    <a asp-controller="Category"
       asp-action="Create"
       class="btn btn-filter">
        + Yeni Kategori
    </a>

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}


@if (Model.Any())
{
    <div class="row g-4">

        @foreach (var category in Model)
        {
            <div class="col-md-6 col-lg-4">

                <div class="category-card">

                    <div class="category-card-icon">
                        📂
                    </div>

                    <div class="category-card-content">

                        <h5>
                            @category.Name
                        </h5>

                        <p>
                            @category.Description
                        </p>

                    </div>

                    <div class="category-card-actions">

                        <form asp-controller="Category"
                              asp-action="Delete"
                              method="post"
                              onsubmit="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?');">

                            <input type="hidden"
                                   name="id"
                                   value="@category.Id" />

                            <button type="submit"
                                    class="btn btn-outline-danger btn-sm">
                                🗑 Sil
                            </button>

                        </form>

                    </div>

                </div>

            </div>
        }

    </div>
}
else
{
    <div class="empty-category-state">

        <div class="empty-category-icon">
            📁
        </div>

        <h4>Henüz kategori bulunmuyor</h4>

        <p>
            Hizmetlerinizi düzenlemek için ilk kategorinizi oluşturun.
        </p>

        <a asp-controller="Category"
           asp-action="Create"
           class="btn btn-filter">
            + İlk Kategoriyi Oluştur
        </a>

    </div>
}