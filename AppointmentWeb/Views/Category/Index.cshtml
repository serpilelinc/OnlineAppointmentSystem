@model List<AppointmentWeb.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Kategori Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="mb-1">Kategori Yönetimi</h2>

        <p class="text-muted mb-0">
            Platformda sunulan hizmetleri kategoriler altında yönetin.
        </p>
    </div>

    <a asp-controller="Category"
       asp-action="Create"
       class="btn btn-filter">
        + Yeni Kategori
    </a>

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}


@if (Model.Any())
{
    <div class="row g-4">

        @foreach (var category in Model)
        {
            <div class="col-md-6 col-lg-4">

                <div class="category-card">

                    <div class="category-card-icon">
                        📂
                    </div>

                    <div class="category-card-content">

                        <h5>
                            @category.Name
                        </h5>

                        <p>
                            @category.Description
                        </p>

                    </div>

                    <div class="category-card-actions">

                        <form asp-controller="Category"
                              asp-action="Delete"
                              method="post"
                              onsubmit="confirmFormSubmit(event, 'Bu kategoriyi silmek istediğinize emin misiniz?');">

                            <input type="hidden"
                                   name="id"
                                   value="@category.Id" />

                            <button type="submit"
                                    class="btn btn-outline-danger btn-sm">
                                🗑 Sil
                            </button>

                        </form>

                    </div>

                </div>

            </div>
        }

    </div>
}
else
{
    <div class="empty-state animate-fade-in-up">
        <div class="empty-state-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
            </svg>
        </div>
        <h4>Henüz bir hizmet kategorisi yok</h4>
        <p>Hizmetlerinizi düzenli bir şekilde sunmak için ilk kategorinizi hemen oluşturun.</p>
        <a asp-controller="Category" asp-action="Create" class="btn btn-primary px-4 py-2" style="border-radius: 12px; font-weight: 600;">
            <i class="bi bi-plus-lg me-2"></i> İlk Kategoriyi Oluştur
        </a>
    </div>
}