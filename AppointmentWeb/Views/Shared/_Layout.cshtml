<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RandevuPlus</title>
    <link rel="icon" type="image/jpeg" href="~/images/favicon.jpg" />

    <script type="importmap"></script>

    <script>
        // Sayfa çizilmeden önce temayı uygula (FOUC önlemi)
        const currentUserName = '@(Context.Session.GetString("UserName") ?? "guest")';
        let savedTheme = 'classic';
        let savedMode = 'light';
        
        if (currentUserName !== 'guest') {
            const themeStorageKey = 'randevuplus-theme-' + currentUserName;
            window.themeStorageKey = themeStorageKey; // For site.js
            
            // Kullanıcının kendi teması yoksa, son global temayı al
            savedTheme = localStorage.getItem(themeStorageKey) || localStorage.getItem('randevuplus-theme-global-last') || 'classic';
            savedMode = localStorage.getItem(themeStorageKey + '-mode') || localStorage.getItem('randevuplus-theme-global-last-mode') || 'light';
        } else {
            // Misafir (Login sayfası) - Son bilinen global temayı kullan
            window.themeStorageKey = 'randevuplus-theme-global-last'; 
            savedTheme = localStorage.getItem('randevuplus-theme-global-last') || 'classic';
            savedMode = localStorage.getItem('randevuplus-theme-global-last-mode') || 'light';
        }
        
        document.documentElement.setAttribute('data-theme', savedTheme);
        document.documentElement.setAttribute('data-mode', savedMode);
    </script>

    <!-- Google Fonts: Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/themes.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/AppointmentWeb.styles.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

@{
    var userName = Context.Session.GetString("UserName");
    var userRole = Context.Session.GetString("UserRole");
    var isLoggedIn = !string.IsNullOrWhiteSpace(userName);
}

@if (!isLoggedIn)
{
    <header class="sticky-top">
        <nav class="navbar navbar-expand-sm navbar-dark glass-navbar mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center fw-bold text-white text-decoration-none" asp-controller="Home" asp-action="Index" style="font-size: 1.5rem; letter-spacing: -0.5px;">
                    <img src="~/images/favicon.jpg" alt="Logo" class="me-2 rounded-3 shadow-sm" style="width: 38px; height: 38px; object-fit: cover;" asp-append-version="true" />
                    <span>Randevu<span style="color: var(--secondary);">Plus</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Auth" asp-action="Login">Giriş Yap</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Auth" asp-action="Register">Kayıt Ol</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RandevuPlus
        </div>
    </footer>
}
else
{
    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <div class="glass-sidebar" id="sidebar-wrapper">
            <div class="sidebar-heading text-center py-4 fs-4 fw-bold border-bottom">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none d-flex align-items-center justify-content-center fw-bold" style="letter-spacing: -0.5px;">
                    <img src="~/images/favicon.jpg" alt="Logo" class="rounded-3 shadow-sm me-2" style="width: 45px; height: 45px; object-fit: cover;" asp-append-version="true" />
                    <span>Randevu<span style="color: var(--secondary);">Plus</span></span>
                </a>
            </div>
            <div class="list-group list-group-flush mt-3 px-3">
                
                @if (userRole == "Customer")
                {
                    <a class="sidebar-link mb-2 rounded-3" asp-controller="Appointment" asp-action="Create">
                        <i class="bi bi-plus-square"></i> Yeni Randevu
                    </a>
                    <a class="sidebar-link mb-2 rounded-3" asp-controller="Appointment" asp-action="MyAppointments">
                        <i class="bi bi-calendar-check"></i> Randevularım
                    </a>
                }

                @if (userRole == "Admin")
                {
                    <a class="sidebar-link mb-2 rounded-3" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                    <a class="sidebar-link mb-2 rounded-3" asp-controller="Appointment" asp-action="Index">
                        <i class="bi bi-calendar3"></i> Tüm Randevular
                    </a>
                    <a class="sidebar-link mb-2 rounded-3" asp-controller="Staff" asp-action="Index">
                        <i class="bi bi-people"></i> Hizmet Verenler
                    </a>
                    <a class="sidebar-link mb-2 rounded-3" asp-controller="ServiceType" asp-action="Index">
                        <i class="bi bi-tools"></i> Hizmetler
                    </a>
                    <a class="sidebar-link mb-2 rounded-3" asp-controller="Category" asp-action="Index">
                        <i class="bi bi-grid"></i> Kategoriler
                    </a>
                }

                @if (userRole == "Staff")
                {
                    <a class="sidebar-link mb-2 rounded-3" asp-controller="Appointment" asp-action="StaffAppointments">
                        <i class="bi bi-calendar-check"></i> Randevularım
                    </a>
                    <a class="sidebar-link mb-2 rounded-3" asp-controller="Staff" asp-action="MyWorkingHours">
                        <i class="bi bi-clock"></i> Çalışma Saatlerim
                    </a>
                }
                
                <hr class="border-light opacity-25 my-3" />
                <a class="sidebar-link mb-2 rounded-3" asp-controller="Settings" asp-action="Index">
                    <i class="bi bi-gear"></i> Ayarlar
                </a>
            </div>
        </div>

        <!-- Page Content -->
        <div id="page-content-wrapper" class="flex-grow-1">
            
            <nav class="navbar navbar-expand-lg glass-navbar border-bottom px-4">
                <div class="d-flex w-100 align-items-center">
                    <button class="btn btn-primary d-md-none rounded-circle shadow-sm me-3" id="menu-toggle">
                        <i class="bi bi-list"></i>
                    </button>

                    <div class="ms-auto d-flex align-items-center">
                        <div class="d-none d-md-block me-3 text-end">
                            <span class="text-dark fw-bold d-block" style="line-height: 1.2;">@userName</span>
                            <small class="text-primary fw-medium">@userRole</small>
                        </div>
                        <a class="btn btn-outline-primary btn-sm rounded-pill px-3 ms-2" asp-controller="Auth" asp-action="Logout">
                            <i class="bi bi-box-arrow-right"></i> Çıkış
                        </a>
                    </div>
                </div>
            </nav>

            <div class="container-fluid p-4 dashboard-main-content">
                <main role="main">
                    @RenderBody()
                </main>
            </div>

        </div>
    </div>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js"
        asp-append-version="true">
</script>

<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // Global SweetAlert2 Toast Logic
    const Toast = Swal.mixin({
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: 4000,
        timerProgressBar: true,
        background: 'var(--surface)',
        color: 'var(--text)',
        customClass: {
            popup: 'shadow-lg border-0 rounded-4'
        },
        didOpen: (toast) => {
            toast.addEventListener('mouseenter', Swal.stopTimer)
            toast.addEventListener('mouseleave', Swal.resumeTimer)
        }
    });

    var successMsg = '@Html.Raw(TempData["SuccessMessage"])';
    var errorMsg = '@Html.Raw(TempData["ErrorMessage"])';

    if (successMsg && successMsg !== '') {
        Toast.fire({
            icon: 'success',
            title: successMsg
        });
        
        // Eski tip düz yeşil/kırmızı mesajları gizle
        setTimeout(() => {
            document.querySelectorAll('.alert-success, .alert-danger').forEach(el => el.style.display = 'none');
        }, 10);
    }
    
    if (errorMsg && errorMsg !== '') {
        Toast.fire({
            icon: 'error',
            title: errorMsg
        });

        setTimeout(() => {
            document.querySelectorAll('.alert-success, .alert-danger').forEach(el => el.style.display = 'none');
        }, 10);
    }
</script>

<!-- SIGNALR REAL-TIME NOTIFICATIONS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var userRole = '@userRole';
        
        // Sadece Admin ve Staff personeli dinlesin
        if (userRole === 'Admin' || userRole === 'Staff') {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("http://localhost:5065/hubs/appointment")
                .withAutomaticReconnect()
                .build();

            connection.on("ReceiveNewAppointment", function (customerName, appointmentDate) {
                // Tema uyumlu Toast ile göster
                Toast.fire({
                    icon: 'info',
                    title: 'Yeni Randevu!',
                    text: `${customerName}, ${appointmentDate} tarihi için randevu oluşturdu.`
                });
            });

            connection.start().catch(function (err) {
                console.error("SignalR Bağlantı Hatası: ", err.toString());
            });
        }
    });
</script>

<!-- Dark Mode Toggle Button -->
<button type="button" class="theme-toggle-btn shadow-lg" onclick="toggleDarkMode()" aria-label="Gece/Gündüz Modu Değiştir">
    <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
    </svg>
    <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
</button>

@await RenderSectionAsync(
    "Scripts",
    required: false
)

</body>
</html>