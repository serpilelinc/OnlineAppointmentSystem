@model List<AppointmentWeb.Models.StaffViewModel>

@{
    ViewData["Title"] = "Hizmet Veren Yönetimi";
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}



<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Hizmet Veren Yönetimi</h2>

        <p class="text-muted mb-0">
            Sistemde kayıtlı hizmet verenleri yönetin ve kullanıcı hesabı oluşturun.
        </p>
    </div>

    <a asp-controller="Staff"
       asp-action="Create"
       class="btn btn-success">
        Yeni Hizmet Veren Ekle
    </a>
</div>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered mt-4 align-middle">

            <thead>
                <tr>
                    <th>Ad Soyad</th>
<th>E-posta</th>
<th>Uzmanlık / Unvan</th>
<th>Yönetim</th>
<th>Hesap</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var staff in Model)
                {
                    <tr>

                        <td>
                            @staff.Id
                        </td>

                        <td>
                            @staff.FullName
                        </td>

                        <td>
                            @staff.Email
                        </td>

                        <td>
                            @staff.Title
                        </td>

                        <td>
                            <a asp-controller="Staff"
                               asp-action="Manage"
                               asp-route-id="@staff.Id"
                               class="btn btn-primary btn-sm">
                                Yönet
                            </a>
                            <form asp-controller="Staff"
                                  asp-action="Delete"
                                  asp-route-id="@staff.Id"
                                  method="post"
                                  class="d-inline"
                                  id="deleteForm-@staff.Id">
                                <input type="hidden" name="forceDelete" id="forceDelete-@staff.Id" value="false" />
                                <button type="button" class="btn btn-danger btn-sm" onclick="confirmDelete(@staff.Id, '@Html.Raw(staff.FullName.Replace("'", "\\'"))')">
                                    Sil
                                </button>
                            </form>
                        </td>


                        <td>
    @if (staff.HasUserAccount)
    {
        <span class="badge bg-success">
            Hesap Aktif
        </span>
    }
    else
    {
        <form asp-controller="Staff"
              asp-action="CreateUserAccount"
              method="post"
              class="d-flex gap-2">

            <input type="hidden"
                   name="StaffId"
                   value="@staff.Id" />

            <input type="password"
                   name="Password"
                   class="form-control form-control-sm"
                   style="max-width: 160px;"
                   placeholder="Şifre belirle"
                   minlength="6"
                   required />

            <button type="submit"
                    class="btn btn-dark btn-sm">
                Hesap Oluştur
            </button>

        </form>
    }
</td>

                    </tr>
                }

            </tbody>

        </table>
    </div>
}
else
{
    <div class="empty-state animate-fade-in-up mt-4">
        <div class="empty-state-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
        </div>
        <h4>Ekibinizde henüz kimse yok</h4>
        <p>Müşterilerinize hizmet sunabilmek için ilk personelinizi sisteme dahil edin.</p>
        <a asp-controller="Staff" asp-action="Manage" class="btn btn-primary px-4 py-2" style="border-radius: 12px; font-weight: 600;">
            <i class="bi bi-person-plus-fill me-2"></i> Yeni Personel Ekle
        </a>
    </div>
}

@section Scripts {
    <script>
        function confirmDelete(staffId, staffName) {
            $.ajax({
                url: '/Staff/CheckFutureAppointments/' + staffId,
                type: 'GET',
                success: function(response) {
                    var count = response.count;
                    if (count > 0) {
                        Swal.fire({
                            title: 'Emin misiniz?',
                            html: `<b>${staffName}</b> adlı personelin gelecekte <b>${count}</b> adet iptal edilmemiş randevusu bulunmaktadır.<br><br>Personeli silerseniz bu randevular <b>otomatik iptal edilecek</b> ve müşterilere bilgilendirme e-postası gönderilecektir. Onaylıyor musunuz?`,
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonText: 'Evet, Sil ve İptal Et',
                            cancelButtonText: 'Hayır, Vazgeç',
                            customClass: {
                                confirmButton: 'swal2-confirm',
                                cancelButton: 'swal2-cancel'
                            }
                        }).then((result) => {
                            if (result.isConfirmed) {
                                $('#forceDelete-' + staffId).val('true');
                                $('#deleteForm-' + staffId).submit();
                            }
                        });
                    } else {
                        Swal.fire({
                            title: 'Emin misiniz?',
                            text: `${staffName} adlı personeli silmek istediğinize emin misiniz?`,
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonText: 'Evet, Sil',
                            cancelButtonText: 'Hayır, İptal',
                            customClass: {
                                confirmButton: 'swal2-confirm',
                                cancelButton: 'swal2-cancel'
                            }
                        }).then((result) => {
                            if (result.isConfirmed) {
                                $('#deleteForm-' + staffId).submit();
                            }
                        });
                    }
                },
                error: function() {
                    Swal.fire('Hata', 'Randevu bilgileri kontrol edilemedi.', 'error');
                }
            });
        }
    </script>
}