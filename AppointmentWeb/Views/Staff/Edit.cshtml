@model AppointmentWeb.Models.StaffViewModel

@{
    ViewData["Title"] = "Hizmet Veren Düzenle";
}

<div class="row justify-content-center">

    <div class="col-lg-7">

        <div class="card shadow-sm">

            <div class="card-body p-4">

                <div class="mb-4">

                    <p class="appointment-eyebrow mb-1">
                        Hizmet Veren Yönetimi
                    </p>

                    <h2>
                        Bilgileri Düzenle
                    </h2>

                    <p class="text-muted">
                        Hizmet verenin temel bilgilerini güncelleyebilirsiniz.
                    </p>

                </div>


                <form asp-controller="Staff"
                      asp-action="Edit"
                      asp-route-id="@Model.Id"
                      method="post">

                    <input asp-for="Id"
                           type="hidden" />

                    <div asp-validation-summary="All"
                         class="text-danger mb-3">
                    </div>


                    <div class="mb-3">

                        <label asp-for="FullName"
                               class="form-label">
                            Ad Soyad
                        </label>

                        <input asp-for="FullName"
                               class="form-control" />

                        <span asp-validation-for="FullName"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-3">

                        <label asp-for="Email"
                               class="form-label">
                            E-posta
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-4">

                        <label asp-for="Title"
                               class="form-label">
                            Unvan / Uzmanlık
                        </label>

                        <input asp-for="Title"
                               class="form-control"
                               placeholder="Örn: Kuaför, Elektrik Ustası, Matematik Eğitmeni" />

                        <span asp-validation-for="Title"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="d-flex justify-content-between">

                        <a asp-controller="Staff"
                           asp-action="Manage"
                           asp-route-id="@Model.Id"
                           class="btn btn-clear">
                            ← Geri Dön
                        </a>

                        <button type="submit"
                                class="btn btn-filter">
                            ✓ Değişiklikleri Kaydet
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}