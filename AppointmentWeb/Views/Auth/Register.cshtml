@model AppointmentWeb.Models.RegisterViewModel

@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-lg-10">
        <div class="card border-0 overflow-hidden" style="border-radius: 30px; box-shadow: 0 15px 40px rgba(167, 139, 250, 0.15);">
            <div class="row g-0 flex-row-reverse">
                <!-- Sağ Kolon: Görsel (Reversed) -->
                <div class="col-md-6 d-none d-md-block position-relative">
                    <img src="~/images/login_illustration.jpg" asp-append-version="true" alt="Kayıt Ol" class="img-fluid h-100 w-100" style="object-fit: cover; transform: scaleX(-1);" />
                    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(135deg, rgba(52,211,153,0.2), rgba(167,139,250,0.2));"></div>
                </div>

                <!-- Sol Kolon: Form -->
                <div class="col-md-6 d-flex align-items-center">
                    <div class="card-body p-5 w-100">

                        <div class="text-center mb-4">
                            <div class="d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px; border-radius: 16px; background: linear-gradient(135deg, var(--primary), var(--secondary)); box-shadow: 0 8px 25px rgba(125,42,232,0.4);">
                                <i class="bi bi-calendar-check-fill text-white" style="font-size: 2.2rem;"></i>
                            </div>
                        </div>

                        <h2 class="text-center mb-2" style="color: var(--primary-dark); font-weight: 800; font-size: 2.2rem;">Kayıt Ol 🚀</h2>
                        <p class="text-center text-muted mb-4">Harika bir deneyim için ilk adım!</p>

                        <form asp-controller="Auth"
                              asp-action="Register"
                              method="post">

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3">
                            </div>

                            <div class="mb-4">
                                <label asp-for="FullName"
                                       class="form-label">
                                    Ad Soyad
                                </label>

                                <input asp-for="FullName"
                                       class="form-control" placeholder="Örn: Ahmet Yılmaz" />

                                <span asp-validation-for="FullName"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Email"
                                       class="form-label">
                                    E-posta
                                </label>

                                <input asp-for="Email"
                                       class="form-control" placeholder="isim@ornek.com" />

                                <span asp-validation-for="Email"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Password"
                                       class="form-label">
                                    Şifre
                                </label>

                                <input asp-for="Password"
                                       type="password"
                                       class="form-control" placeholder="Güçlü bir şifre girin" />

                                <span asp-validation-for="Password"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="ConfirmPassword"
                                       class="form-label">
                                    Şifre Tekrar
                                </label>

                                <input asp-for="ConfirmPassword"
                                       type="password"
                                       class="form-control" placeholder="Şifrenizi doğrulayın" />

                                <span asp-validation-for="ConfirmPassword"
                                      class="text-danger">
                                </span>
                            </div>

                            <button type="submit"
                                    class="btn btn-success w-100 py-3 mt-2" style="font-size: 1.1rem; background: linear-gradient(135deg, var(--secondary), #10b981);">
                                Maceraya Başla! ✨
                            </button>

                        </form>

                        <div class="text-center mt-4 pt-3 border-top border-light">
                            <span class="text-muted">Zaten hesabınız var mı?</span>
                            <br />
                            <a asp-controller="Auth"
                               asp-action="Login" class="fw-bold" style="color: var(--primary);">
                                O zaman hemen Giriş Yapın! 🎉
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}