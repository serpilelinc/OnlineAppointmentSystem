@model AppointmentWeb.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Şifremi Unuttum";
}

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-lg-10">
        <div class="card border-0 overflow-hidden" style="border-radius: 30px; box-shadow: var(--shadow-lg);">
            <div class="row g-0">
                <!-- Sol Kolon: Görsel -->
                <div class="col-md-6 d-none d-md-block position-relative">
                    <img src="~/images/login_illustration.jpg" asp-append-version="true" alt="Login" class="img-fluid h-100 w-100" style="object-fit: cover;" />
                    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(135deg, var(--primary-soft), transparent);"></div>
                </div>

                <!-- Sağ Kolon: Form -->
                <div class="col-md-6 d-flex align-items-center">
                    <div class="card-body p-5 w-100">
                        <div class="text-center mb-4">
                            <h2 style="color: var(--danger); font-weight: 800; font-size: 2.2rem;">Şifrenizi Mi Unuttunuz? 😢</h2>
                            <p class="text-muted mt-2">E-posta adresinizi girin, size şifre sıfırlama bağlantısı gönderelim.</p>
                        </div>

                        <form asp-action="ForgotPassword" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="mb-4">
                                <label asp-for="Email" class="form-label">E-posta Adresi</label>
                                <input asp-for="Email" class="form-control" placeholder="ornek@email.com" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="d-grid gap-2 mb-4">
                                <button type="submit" class="btn btn-primary py-3" style="font-size: 1.1rem; background: linear-gradient(135deg, var(--danger), #f43f5e);">
                                    Bağlantı Gönder <i class="bi bi-send ms-1"></i>
                                </button>
                            </div>

                            <div class="text-center border-top border-light pt-3">
                                <a asp-action="Login" class="fw-bold text-decoration-none" style="color: var(--primary);">Giriş sayfasına geri dön</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
