@model AppointmentWeb.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Şifre Sıfırlama";
}

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-lg-10">
        <div class="card border-0 overflow-hidden" style="border-radius: 30px; box-shadow: 0 15px 40px rgba(167, 139, 250, 0.15);">
            <div class="row g-0">
                <!-- Sol Kolon: Görsel -->
                <div class="col-md-6 d-none d-md-block position-relative">
                    <img src="~/images/login_illustration.jpg" asp-append-version="true" alt="Login" class="img-fluid h-100 w-100" style="object-fit: cover; transform: scaleX(-1);" />
                    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(135deg, rgba(167,139,250,0.2), rgba(251,113,133,0.2));"></div>
                </div>

                <!-- Sağ Kolon: Form -->
                <div class="col-md-6 d-flex align-items-center">
                    <div class="card-body p-5 w-100">
                        <div class="text-center mb-4">
                            <h2 style="color: var(--primary-dark); font-weight: 800; font-size: 2.2rem;">Yeni Şifre Belirleme 🔒</h2>
                            <p class="text-muted mt-2">Lütfen yeni şifrenizi giriniz.</p>
                        </div>

                        <form asp-action="ResetPassword" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <input type="hidden" asp-for="Token" />
                            <input type="hidden" asp-for="Email" />

                            <div class="mb-4">
                                <label asp-for="NewPassword" class="form-label">Yeni Şifre</label>
                                <input asp-for="NewPassword" class="form-control" placeholder="En az 6 karakter" />
                                <span asp-validation-for="NewPassword" class="text-danger"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="ConfirmPassword" class="form-label">Yeni Şifre (Tekrar)</label>
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Şifrenizi tekrar giriniz" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary py-3" style="font-size: 1.1rem; background: linear-gradient(135deg, var(--primary), var(--secondary));">
                                    Şifremi Sıfırla ✨
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
