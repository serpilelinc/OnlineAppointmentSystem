@{
    ViewData["Title"] = "Ayarlar";
}

<div class="container py-4 fade-in">
    
    <!-- Üst Başlık Bölümü -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1" style="color: var(--primary-dark);">Hesap Ayarları</h4>
            <p class="text-muted mb-0">Kişisel bilgilerinizi, şifrenizi ve bildirim tercihlerinizi yönetin.</p>
        </div>
    </div>

    <!-- Başarı/Hata Mesajları -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm" role="alert" style="background: rgba(16,185,129,0.1); color: #065f46;">
            <i class="bi bi-check-circle-fill me-2"></i>
            <strong>Başarılı!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm" role="alert" style="background: rgba(255,0,127,0.1); color: #9f1239;">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Hata!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- SOL MENÜ: SEKMELER GİBİ GÖRÜNEN KART -->
        <div class="col-lg-3">
            <div class="card glass-card border-0 h-100">
                <div class="card-body p-0">
                    <div class="p-4 text-center border-bottom border-light">
                        <div class="d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; border-radius: 50%; background: linear-gradient(135deg, var(--primary), var(--secondary)); color: white; font-size: 2rem; font-weight: bold; box-shadow: 0 8px 16px rgba(125,42,232,0.3);">
                            @((ViewBag.UserName != null && ViewBag.UserName.Length >= 2) ? ViewBag.UserName.Substring(0, 2).ToUpper() : "US")
                        </div>
                        <h6 class="fw-bold mb-1">@(ViewBag.UserName ?? "Mevcut Kullanıcı")</h6>
                        <small class="text-muted">Müşteri Profili</small>
                    </div>
                    <div class="list-group list-group-flush border-0 p-2">
                        <a href="#profileSection" class="list-group-item list-group-item-action border-0 rounded-3 mb-1 active-menu-item" style="background: rgba(125,42,232,0.1); color: var(--primary-dark); font-weight: 600;">
                            <i class="bi bi-person-fill me-2"></i> Profil Bilgileri
                        </a>
                        <a href="#passwordSection" class="list-group-item list-group-item-action border-0 rounded-3 mb-1 text-secondary">
                            <i class="bi bi-shield-lock-fill me-2"></i> Şifre Değiştir
                        </a>
                        <a href="#notificationSection" class="list-group-item list-group-item-action border-0 rounded-3 mb-1 text-secondary">
                            <i class="bi bi-bell-fill me-2"></i> Bildirimler
                        </a>
                        <a href="#themeSection" class="list-group-item list-group-item-action border-0 rounded-3 text-secondary">
                            <i class="bi bi-palette-fill me-2"></i> Görünüm
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- SAĞ İÇERİK: FORMLAR -->
        <div class="col-lg-9">
            
            <!-- Profil Bilgileri -->
            <div id="profileSection" class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4 p-lg-5">
                    <div class="d-flex align-items-center mb-4">
                        <div class="me-3 d-flex align-items-center justify-content-center rounded-3" style="width: 48px; height: 48px; background: rgba(0,196,204,0.1); color: var(--secondary); font-size: 1.5rem;">
                            <i class="bi bi-person"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Profil Bilgileri</h5>
                            <small class="text-muted">Kişisel bilgilerinizi buradan güncelleyin</small>
                        </div>
                    </div>

                    <form asp-action="UpdateProfile" method="post">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">Ad Soyad</label>
                                <input type="text" name="fullName" class="form-control" value="@ViewBag.UserName" placeholder="Adınızı girin" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">Telefon (İsteğe Bağlı)</label>
                                <input type="text" name="phone" class="form-control" value="@ViewBag.UserPhone" placeholder="05XX XXX XX XX">
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold small text-muted">E-posta Adresi</label>
                                <input type="email" name="email" class="form-control" value="@ViewBag.UserEmail" required>
                            </div>
                            <div class="col-12 text-end mt-4">
                                <button type="submit" class="btn btn-primary px-4 shadow-sm" style="background: linear-gradient(135deg, var(--secondary), var(--primary)); border: none;">
                                    Değişiklikleri Kaydet
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Şifre Değiştirme -->
            <div id="passwordSection" class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4 p-lg-5">
                    <div class="d-flex align-items-center mb-4">
                        <div class="me-3 d-flex align-items-center justify-content-center rounded-3" style="width: 48px; height: 48px; background: rgba(255,0,127,0.1); color: var(--danger); font-size: 1.5rem;">
                            <i class="bi bi-shield-lock"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Şifre Değiştir</h5>
                            <small class="text-muted">Hesabınızın güvenliği için güçlü bir şifre kullanın</small>
                        </div>
                    </div>

                    <form asp-action="ChangePassword" method="post">
                        <div class="row g-4">
                            <div class="col-12">
                                <label class="form-label fw-bold small text-muted">Mevcut Şifre</label>
                                <input type="password" name="currentPassword" class="form-control" placeholder="••••••••" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">Yeni Şifre</label>
                                <input type="password" name="newPassword" class="form-control" placeholder="••••••••" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">Yeni Şifre (Tekrar)</label>
                                <input type="password" name="confirmPassword" class="form-control" placeholder="••••••••" required>
                            </div>
                            <div class="col-12 text-end mt-4">
                                <button type="submit" class="btn btn-primary px-4 shadow-sm" style="background: var(--primary); border: none;">
                                    Şifreyi Güncelle
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Bildirim Tercihleri (Mock) -->
            <div id="notificationSection" class="card border-0 shadow-sm rounded-4 mb-5">
                <div class="card-body p-4 p-lg-5">
                    <div class="d-flex align-items-center mb-4">
                        <div class="me-3 d-flex align-items-center justify-content-center rounded-3" style="width: 48px; height: 48px; background: rgba(16,185,129,0.1); color: var(--success); font-size: 1.5rem;">
                            <i class="bi bi-bell"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Bildirim Tercihleri</h5>
                            <small class="text-muted">Sistemden hangi kanallarla haber almak istiyorsunuz?</small>
                        </div>
                    </div>

                    <form asp-action="UpdateNotifications" method="post">
                        <div class="list-group list-group-flush border-0">
                            <!-- E-Posta -->
                            <div class="list-group-item border-0 px-0 py-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-1 fw-bold">E-Posta Bildirimleri</h6>
                                    <small class="text-muted">Randevu hatırlatmaları ve kampanya e-postaları alın.</small>
                                </div>
                                <div class="form-check form-switch" style="font-size: 1.5rem;">
                                    <input class="form-check-input" type="checkbox" name="emailNotif" value="true" @(ViewBag.EmailNotif == "true" ? "checked" : "") role="switch">
                                </div>
                            </div>
                            <!-- SMS -->
                            <div class="list-group-item border-0 px-0 py-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-1 fw-bold">SMS Bildirimleri</h6>
                                    <small class="text-muted">Randevu saatiniz yaklaşırken telefonunuza mesaj alın.</small>
                                </div>
                                <div class="form-check form-switch" style="font-size: 1.5rem;">
                                    <input class="form-check-input" type="checkbox" name="smsNotif" value="true" @(ViewBag.SmsNotif == "true" ? "checked" : "") role="switch">
                                </div>
                            </div>
                        </div>

                        <div class="text-end mt-4">
                            <button type="submit" class="btn btn-outline-primary px-4 shadow-sm" style="border-width: 2px;">
                                Tercihleri Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Tema Ayarları -->
            <div id="themeSection" class="card border-0 shadow-sm rounded-4 mb-5">
                <div class="card-body p-4 p-lg-5">
                    <div class="d-flex align-items-center mb-4">
                        <div class="me-3 d-flex align-items-center justify-content-center rounded-3" style="width: 48px; height: 48px; background: rgba(125,42,232,0.1); color: var(--primary); font-size: 1.5rem;">
                            <i class="bi bi-palette"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Görünüm ve Tema</h5>
                            <small class="text-muted">RandevuPlus arayüzünü tarzınıza göre özelleştirin.</small>
                        </div>
                    </div>

                    <div class="row g-3">
                        <!-- Theme Cards -->
                        <div class="col-md-4 col-sm-6">
                            <div class="card theme-selector-card h-100 cursor-pointer position-relative overflow-hidden" data-theme-name="classic" onclick="setTheme('classic')">
                                <div class="position-absolute top-0 end-0 p-2 theme-active-badge d-none">
                                    <span class="badge bg-primary rounded-circle p-1"><i class="bi bi-check-lg text-white"></i></span>
                                </div>
                                <div class="card-body p-3">
                                    <div class="d-flex mb-3 gap-2">
                                        <div style="width: 20px; height: 20px; border-radius: 50%; background: #7d2ae8;"></div>
                                        <div style="width: 20px; height: 20px; border-radius: 50%; background: #00c4cc;"></div>
                                    </div>
                                    <h6 class="fw-bold mb-1">Classic</h6>
                                    <small class="text-muted" style="font-size: 0.75rem;">RandevuPlus Orijinal</small>
                                </div>
                                <div class="theme-preview-strip" style="height: 6px; width: 100%; background: linear-gradient(90deg, #7d2ae8, #00c4cc);"></div>
                            </div>
                        </div>
                        
                        <div class="col-md-4 col-sm-6">
                            <div class="card theme-selector-card h-100 cursor-pointer position-relative overflow-hidden" data-theme-name="ocean" onclick="setTheme('ocean')">
                                <div class="position-absolute top-0 end-0 p-2 theme-active-badge d-none">
                                    <span class="badge bg-primary rounded-circle p-1"><i class="bi bi-check-lg text-white"></i></span>
                                </div>
                                <div class="card-body p-3">
                                    <div class="d-flex mb-3 gap-2">
                                        <div style="width: 20px; height: 20px; border-radius: 50%; background: #0284c7;"></div>
                                        <div style="width: 20px; height: 20px; border-radius: 50%; background: #06b6d4;"></div>
                                    </div>
                                    <h6 class="fw-bold mb-1">Ocean Breeze</h6>
                                    <small class="text-muted" style="font-size: 0.75rem;">Ferah & Sakin</small>
                                </div>
                                <div class="theme-preview-strip" style="height: 6px; width: 100%; background: linear-gradient(90deg, #0284c7, #06b6d4);"></div>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6">
                            <div class="card theme-selector-card h-100 cursor-pointer position-relative overflow-hidden" data-theme-name="forest" onclick="setTheme('forest')">
                                <div class="position-absolute top-0 end-0 p-2 theme-active-badge d-none">
                                    <span class="badge bg-primary rounded-circle p-1"><i class="bi bi-check-lg text-white"></i></span>
                                </div>
                                <div class="card-body p-3">
                                    <div class="d-flex mb-3 gap-2">
                                        <div style="width: 20px; height: 20px; border-radius: 50%; background: #166534;"></div>
                                        <div style="width: 20px; height: 20px; border-radius: 50%; background: #86efac;"></div>
                                    </div>
                                    <h6 class="fw-bold mb-1">Forest Calm</h6>
                                    <small class="text-muted" style="font-size: 0.75rem;">Doğal & Modern</small>
                                </div>
                                <div class="theme-preview-strip" style="height: 6px; width: 100%; background: linear-gradient(90deg, #166534, #86efac);"></div>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6">
                            <div class="card theme-selector-card h-100 cursor-pointer position-relative overflow-hidden" data-theme-name="sunset" onclick="setTheme('sunset')">
                                <div class="position-absolute top-0 end-0 p-2 theme-active-badge d-none">
                                    <span class="badge bg-primary rounded-circle p-1"><i class="bi bi-check-lg text-white"></i></span>
                                </div>
                                <div class="card-body p-3">
                                    <div class="d-flex mb-3 gap-2">
                                        <div style="width: 20px; height: 20px; border-radius: 50%; background: #f43f5e;"></div>
                                        <div style="width: 20px; height: 20px; border-radius: 50%; background: #f97316;"></div>
                                    </div>
                                    <h6 class="fw-bold mb-1">Sunset Warmth</h6>
                                    <small class="text-muted" style="font-size: 0.75rem;">Sıcak & Samimi</small>
                                </div>
                                <div class="theme-preview-strip" style="height: 6px; width: 100%; background: linear-gradient(90deg, #f43f5e, #f97316);"></div>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6">
                            <div class="card theme-selector-card h-100 cursor-pointer position-relative overflow-hidden" data-theme-name="midnight" onclick="setTheme('midnight')">
                                <div class="position-absolute top-0 end-0 p-2 theme-active-badge d-none">
                                    <span class="badge bg-primary rounded-circle p-1"><i class="bi bi-check-lg text-white"></i></span>
                                </div>
                                <div class="card-body p-3" style="background: #1e293b; color: white;">
                                    <div class="d-flex mb-3 gap-2">
                                        <div style="width: 20px; height: 20px; border-radius: 50%; background: #a855f7;"></div>
                                        <div style="width: 20px; height: 20px; border-radius: 50%; background: #0f172a; border: 1px solid #334155;"></div>
                                    </div>
                                    <h6 class="fw-bold mb-1 text-white">Midnight Pro</h6>
                                    <small class="text-light opacity-75" style="font-size: 0.75rem;">Gerçek Dark Mode</small>
                                </div>
                                <div class="theme-preview-strip" style="height: 6px; width: 100%; background: linear-gradient(90deg, #a855f7, #38bdf8);"></div>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6">
                            <div class="card theme-selector-card h-100 cursor-pointer position-relative overflow-hidden" data-theme-name="monochrome" onclick="setTheme('monochrome')">
                                <div class="position-absolute top-0 end-0 p-2 theme-active-badge d-none">
                                    <span class="badge bg-primary rounded-circle p-1"><i class="bi bi-check-lg text-white"></i></span>
                                </div>
                                <div class="card-body p-3">
                                    <div class="d-flex mb-3 gap-2">
                                        <div style="width: 20px; height: 20px; border-radius: 50%; background: #171717;"></div>
                                        <div style="width: 20px; height: 20px; border-radius: 50%; background: #525252;"></div>
                                    </div>
                                    <h6 class="fw-bold mb-1">Monochrome</h6>
                                    <small class="text-muted" style="font-size: 0.75rem;">Siyah Beyaz Minimal</small>
                                </div>
                                <div class="theme-preview-strip" style="height: 6px; width: 100%; background: linear-gradient(90deg, #171717, #737373);"></div>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6">
                            <div class="card theme-selector-card h-100 cursor-pointer position-relative overflow-hidden" data-theme-name="leopard" onclick="setTheme('leopard')">
                                <div class="position-absolute top-0 end-0 p-2 theme-active-badge d-none">
                                    <span class="badge bg-primary rounded-circle p-1"><i class="bi bi-check-lg text-white"></i></span>
                                </div>
                                <div class="card-body p-3">
                                    <div class="d-flex mb-3 gap-2">
                                        <div style="width: 20px; height: 20px; border-radius: 50%; background: #b45309;"></div>
                                        <div style="width: 20px; height: 20px; border-radius: 50%; background: #451a03;"></div>
                                    </div>
                                    <h6 class="fw-bold mb-1">Leopard Luxe</h6>
                                    <small class="text-muted" style="font-size: 0.75rem;">Premium Taba</small>
                                </div>
                                <div class="theme-preview-strip" style="height: 6px; width: 100%; background: linear-gradient(90deg, #b45309, #d97706);"></div>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6">
                            <div class="card theme-selector-card h-100 cursor-pointer position-relative overflow-hidden" data-theme-name="spider" onclick="setTheme('spider')">
                                <div class="position-absolute top-0 end-0 p-2 theme-active-badge d-none">
                                    <span class="badge bg-primary rounded-circle p-1"><i class="bi bi-check-lg text-white"></i></span>
                                </div>
                                <div class="card-body p-3">
                                    <div class="d-flex mb-3 gap-2">
                                        <div style="width: 20px; height: 20px; border-radius: 50%; background: #dc2626;"></div>
                                        <div style="width: 20px; height: 20px; border-radius: 50%; background: #1e3a8a;"></div>
                                    </div>
                                    <h6 class="fw-bold mb-1">Spider Theme</h6>
                                    <small class="text-muted" style="font-size: 0.75rem;">Ağ Teknolojisi</small>
                                </div>
                                <div class="theme-preview-strip" style="height: 6px; width: 100%; background: linear-gradient(90deg, #dc2626, #1e3a8a);"></div>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6">
                            <div class="card theme-selector-card h-100 cursor-pointer position-relative overflow-hidden" data-theme-name="pink-dream" onclick="setTheme('pink-dream')">
                                <div class="position-absolute top-0 end-0 p-2 theme-active-badge d-none">
                                    <span class="badge bg-primary rounded-circle p-1"><i class="bi bi-check-lg text-white"></i></span>
                                </div>
                                <div class="card-body p-3" style="background: #fdf2f8;">
                                    <div class="d-flex mb-3 gap-2">
                                        <div style="width: 20px; height: 20px; border-radius: 50%; background: #ec4899;"></div>
                                        <div style="width: 20px; height: 20px; border-radius: 50%; background: #f472b6;"></div>
                                    </div>
                                    <h6 class="fw-bold mb-1" style="color: #831843;">Pink Dream</h6>
                                    <small class="text-muted" style="font-size: 0.75rem;">Yumuşak Glamour</small>
                                </div>
                                <div class="theme-preview-strip" style="height: 6px; width: 100%; background: linear-gradient(90deg, #ec4899, #f472b6);"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    /* Ayarlar sayfasına özel küçük animasyonlar */
    .fade-in {
        animation: fadeIn 0.5s ease-out;
    }
    
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .form-switch .form-check-input:checked {
        background-color: var(--secondary);
        border-color: var(--secondary);
    }
    
    .cursor-pointer {
        cursor: pointer;
    }
    
    .theme-selector-card {
        border: 2px solid transparent !important;
        transition: all 0.2s ease;
    }
    
    .theme-selector-card:hover {
        transform: translateY(-3px);
        border-color: rgba(125,42,232,0.3) !important;
    }
</style>
