@model List<AppointmentWeb.Models.AppointmentViewModel>

@{
    ViewData["Title"] = "Randevularım";
}

<div class="mb-4">
    <h2>Randevularım</h2>
    <p class="text-muted">
        Size atanmış randevuları buradan görüntüleyebilirsiniz.
    </p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (Model == null || Model.Count == 0)
{
    <div class="empty-state animate-fade-in-up mt-4">
        <div class="empty-state-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18 8h1a4 4 0 010 8h-1m-3.05 4A9.968 9.968 0 0112 21c-5.523 0-10-4.477-10-10S6.477 1 12 1c4.54 0 8.375 3.033 9.61 7H3.94m11 10A9.968 9.968 0 0022 11h-7m-4 10V11m-4 10V11"/>
            </svg>
        </div>
        <h4>Şu an için bekleyen randevunuz yok</h4>
        <p>Arkanıza yaslanın, kahvenizin tadını çıkarın ve bir sonraki danışanınızı beklerken rahatlayın!</p>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Tarih</th>
                            <th>Müşteri</th>
                            <th>E-posta</th>
                            <th>Hizmet</th>
                            <th>Durum</th>
                            <th>İşlem</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var appointment in Model)
                        {
                            <tr>

                                <td>
                                    @appointment.AppointmentDate.ToString("dd.MM.yyyy HH:mm")
                                </td>

                                <td>
                                    @appointment.CustomerName
                                </td>

                                <td>
                                    @appointment.CustomerEmail
                                </td>

                                <td>
                                    @appointment.ServiceTypeName
                                </td>

                                <td>
                                    @if (appointment.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Bekliyor
                                        </span>
                                    }
                                    else if (appointment.Status == "Confirmed")
                                    {
                                        <span class="badge bg-primary">
                                            Onaylandı
                                        </span>
                                    }
                                    else if (appointment.Status == "Completed")
                                    {
                                        <span class="badge bg-success">
                                            Tamamlandı
                                        </span>
                                    }
                                    else if (appointment.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger">
                                            İptal Edildi
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @appointment.Status
                                        </span>
                                    }
                                </td>
                                <td>
    @if (appointment.Status == "Pending")
    {
        <form asp-action="UpdateStatus"
              method="post"
              class="d-inline">

            <input type="hidden"
                   name="id"
                   value="@appointment.Id" />

            <input type="hidden"
                   name="status"
                   value="Confirmed" />

            <button type="submit"
                    class="btn btn-primary btn-sm">
                Onayla
            </button>
        </form>
    }

    @if (appointment.Status == "Confirmed" && appointment.AppointmentDate <= DateTime.Now)
    {
        <form asp-action="UpdateStatus"
              method="post"
              class="d-inline">

            <input type="hidden"
                   name="id"
                   value="@appointment.Id" />

            <input type="hidden"
                   name="status"
                   value="Completed" />

            <button type="submit"
                    class="btn btn-success btn-sm">
                Tamamla
            </button>
        </form>
    }

    @if (appointment.Status != "Cancelled" &&
         appointment.Status != "Completed")
    {
        <form asp-action="UpdateStatus"
              method="post"
              class="d-inline">

            <input type="hidden"
                   name="id"
                   value="@appointment.Id" />

            <input type="hidden"
                   name="status"
                   value="Cancelled" />

            <button type="submit"
                    class="btn btn-outline-danger btn-sm">
                İptal Et
            </button>
        </form>
    }
</td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>
}